---
import Layout from "../layouts/Layout.astro";
import {
  ArrowRight,
  CheckCircle2,
  PhoneCall,
  Calendar,
  Star,
  ShieldCheck,
  HeartHandshake,
  Sparkles,
  Clock,
  MapPin,
  Smile,
  ChevronDown,
  Award,
  Check,
} from "lucide-vue-next";
---

<Layout title="Home">
  <!-- Hero Section -->
  <section
    class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden bg-slate-50 border-b border-slate-100"
  >
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-gradient-to-r from-white via-white/95 to-primary-50/80 z-10"
      >
      </div>
      <img
        src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80"
        alt="Moderne behandelruimte Tandartsenpraktijk Hengelo"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
      <div class="max-w-3xl">
        <div
          class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-primary-100/80 border border-primary-200 text-primary-800 font-semibold text-sm mb-6 shadow-sm backdrop-blur-sm"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-primary-600 animate-pulse"
          ></span>
          Geen wachtlijst
        </div>

        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6"
        >
          Moderne tandzorg met een <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-primary-500"
            >persoonlijke</span
          > touch.
        </h1>

        <p
          class="text-lg md:text-xl text-slate-600 mb-8 max-w-2xl leading-relaxed"
        >
          Bij Tandartsenpraktijk Hengelo combineren we de nieuwste technologieën
          met oprechte aandacht voor jouw gebit. Ervaar comfortabele, pijnvrije
          en professionele mondzorg in hartje Hengelo.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a
            href="/contact"
            class="inline-flex justify-center items-center gap-2.5 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-bold text-lg transition-all duration-200 shadow-lg shadow-primary-600/25 hover:shadow-primary-600/40 hover:-translate-y-0.5"
          >
            <Calendar class="w-5 h-5" />
            Inschrijven als patiënt
          </a>
          <a
            href="tel:0742480768"
            class="inline-flex justify-center items-center gap-2.5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 hover:border-slate-300 px-8 py-4 rounded-xl font-bold text-lg transition-all duration-200 shadow-sm hover:-translate-y-0.5"
          >
            <PhoneCall class="w-5 h-5 text-primary-600" />
            074 - 248 07 68
          </a>
        </div>

        <!-- Social Proof Strip in Hero -->
        <div
          class="flex flex-wrap items-center gap-6 pt-4 border-t border-slate-200/80"
        >
          <div class="flex items-center gap-2">
            <div class="flex text-amber-400">
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
            </div>
            <span class="text-sm font-bold text-slate-900">4.9 / 5</span>
            <span class="text-xs text-slate-500">(250+ reviews)</span>
          </div>
          <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-2 text-sm text-slate-600">
            <CheckCircle2 class="w-4 h-4 text-emerald-500" />
            <span>Gratis parkeren voor de deur</span>
          </div>
          <div class="h-4 w-px bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-2 text-sm text-slate-600">
            <CheckCircle2 class="w-4 h-4 text-emerald-500" />
            <span>Avondopenstelling (di tot 20:00)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust & Stats Bar -->
  <section class="bg-white py-8 sm:py-10 border-b border-slate-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        <div class="flex items-start lg:items-center gap-3 sm:gap-4 p-1 sm:p-2">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 mt-0.5 lg:mt-0"
          >
            <Star class="w-5 h-5 sm:w-6 sm:h-6 fill-amber-400 text-amber-500" />
          </div>
          <div class="min-w-0">
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight">
              4.9 / 5.0
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5 leading-snug">
              Google Beoordeling
            </p>
          </div>
        </div>

        <div class="flex items-start lg:items-center gap-3 sm:gap-4 p-1 sm:p-2">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center shrink-0 mt-0.5 lg:mt-0"
          >
            <Clock class="w-5 h-5 sm:w-6 sm:h-6" />
          </div>
          <div class="min-w-0">
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight">
              Direct plek
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5 leading-snug">
              Geen wachttijd voor intake
            </p>
          </div>
        </div>

        <div class="flex items-start lg:items-center gap-3 sm:gap-4 p-1 sm:p-2">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5 lg:mt-0"
          >
            <ShieldCheck class="w-5 h-5 sm:w-6 sm:h-6" />
          </div>
          <div class="min-w-0">
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight">
              BIG & KRT
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5 leading-snug">
              Geregistreerde tandartsen
            </p>
          </div>
        </div>

        <div class="flex items-start lg:items-center gap-3 sm:gap-4 p-1 sm:p-2">
          <div
            class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5 lg:mt-0"
          >
            <Award class="w-5 h-5 sm:w-6 sm:h-6" />
          </div>
          <div class="min-w-0">
            <div class="text-xl sm:text-2xl font-extrabold text-slate-900 leading-tight">
              15+ Jaar
            </div>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5 leading-snug">
              Ervaring in Hengelo
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- USP Section -->
  <section class="py-20 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="text-sm font-bold uppercase tracking-wider text-primary-600 mb-2 block"
        >
          Waarom kiezen voor ons
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">
          Mondzorg zoals het hoort te zijn
        </h2>
        <p class="text-lg text-slate-600">
          Geen haastwerk of onverwachte kosten. Wij combineren vakmanschap, de
          modernste technieken en een ontspannen sfeer.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="p-8 rounded-2xl bg-white border border-slate-100 hover:border-primary-100 shadow-sm hover:shadow-xl hover:shadow-primary-900/5 transition-all duration-300 group"
        >
          <div
            class="w-14 h-14 bg-primary-50 rounded-2xl flex items-center justify-center mb-6 text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300"
          >
            <HeartHandshake class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            Persoonlijke Aandacht
          </h3>
          <p class="text-slate-600 leading-relaxed mb-4">
            Bij ons ben je geen nummer. We nemen ruim de tijd voor al je vragen,
            luisteren naar je wensen en zorgen dat je je vanaf de eerste minuut
            op je gemak voelt.
          </p>
          <ul class="space-y-2 text-sm text-slate-500">
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Vast behandelteam
            </li>
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Heldere uitleg in
              begrijpelijke taal
            </li>
          </ul>
        </div>

        <div
          class="p-8 rounded-2xl bg-white border border-slate-100 hover:border-primary-100 shadow-sm hover:shadow-xl hover:shadow-primary-900/5 transition-all duration-300 group"
        >
          <div
            class="w-14 h-14 bg-primary-50 rounded-2xl flex items-center justify-center mb-6 text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300"
          >
            <Sparkles class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            Moderne 3D Technologie
          </h3>
          <p class="text-slate-600 leading-relaxed mb-4">
            Dankzij onze digitale 3D intra-orale mondscanners hoef je bij ons
            nooit meer te happen in vervelend gips. We werken sneller, schoner
            en uiterst nauwkeurig.
          </p>
          <ul class="space-y-2 text-sm text-slate-500">
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Nooit meer happen
              in gips
            </li>
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Digitale röntgen
              met minimale straling
            </li>
          </ul>
        </div>

        <div
          class="p-8 rounded-2xl bg-white border border-slate-100 hover:border-primary-100 shadow-sm hover:shadow-xl hover:shadow-primary-900/5 transition-all duration-300 group"
        >
          <div
            class="w-14 h-14 bg-primary-50 rounded-2xl flex items-center justify-center mb-6 text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300"
          >
            <Clock class="w-7 h-7" />
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            Flexibele Zorg & Spoed
          </h3>
          <p class="text-slate-600 leading-relaxed mb-4">
            Druk schema? Geen probleem. Op dinsdagavond zijn we geopend tot
            20:00 uur. Daarnaast reserveren we dagelijks tijd voor acute
            pijnklachten en spoedgevallen.
          </p>
          <ul class="space-y-2 text-sm text-slate-500">
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Dinsdagavond tot
              20:00 geopend
            </li>
            <li class="flex items-center gap-2">
              <Check class="w-4 h-4 text-primary-500 shrink-0" /> Zelfde dag geholpen
              bij spoed
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Stappenplan Section: "Hoe verloopt je eerste bezoek?" -->
  <section class="py-20 md:py-24 bg-white border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="text-sm font-bold uppercase tracking-wider text-primary-600 mb-2 block"
        >
          Eenvoudig overstappen
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">
          Hoe verloopt je eerste bezoek?
        </h2>
        <p class="text-lg text-slate-600">
          In 4 duidelijke stappen naar een gezonde, zelfverzekerde glimlach.
          Zonder spanning of verrassingen.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 relative"
      >
        <!-- Step 1 -->
        <div
          class="relative bg-slate-50 rounded-2xl p-7 border border-slate-100 flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-primary-600 text-white font-extrabold text-lg flex items-center justify-center mb-6 shadow-md shadow-primary-600/20"
            >
              01
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              Online Aanmelden
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Vul ons online formulier in binnen 2 minuten. Wij nemen contact
              met je op voor het inplannen van je eerste afspraak.
            </p>
          </div>
          <span
            class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-md self-start"
          >
            Binnen 2 minuten geregeld
          </span>
        </div>

        <!-- Step 2 -->
        <div
          class="relative bg-slate-50 rounded-2xl p-7 border border-slate-100 flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-primary-600 text-white font-extrabold text-lg flex items-center justify-center mb-6 shadow-md shadow-primary-600/20"
            >
              02
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              Intake & Controle
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Tijdens de intake maken we kennis, inspecteren we je gebit en
              tandvlees, en maken we zo nodig digitale röntgenfoto's.
            </p>
          </div>
          <span
            class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-md self-start"
          >
            Kennismaking & onderzoek
          </span>
        </div>

        <!-- Step 3 -->
        <div
          class="relative bg-slate-50 rounded-2xl p-7 border border-slate-100 flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-primary-600 text-white font-extrabold text-lg flex items-center justify-center mb-6 shadow-md shadow-primary-600/20"
            >
              03
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              Heldere Begroting
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Mocht er een behandeling nodig zijn, dan bespreken we alle opties
              en ontvang je vooraf een duidelijke kostenbegroting.
            </p>
          </div>
          <span
            class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-md self-start"
          >
            100% transparant
          </span>
        </div>

        <!-- Step 4 -->
        <div
          class="relative bg-slate-50 rounded-2xl p-7 border border-slate-100 flex flex-col justify-between"
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-primary-600 text-white font-extrabold text-lg flex items-center justify-center mb-6 shadow-md shadow-primary-600/20"
            >
              04
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">
              Gezond & Stralend
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Met periodieke controles en professionele preventieve mondhygiëne
              houden we jouw glimlach samen in topconditie.
            </p>
          </div>
          <span
            class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-md self-start"
          >
            Blijvend mooi gebit
          </span>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-bold text-lg transition-colors shadow-lg shadow-primary-600/25"
        >
          Direct inschrijven bij onze praktijk
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Treatments Preview Section -->
  <section class="py-20 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6"
      >
        <div class="max-w-2xl">
          <span
            class="text-sm font-bold uppercase tracking-wider text-primary-600 mb-2 block"
          >
            Deskundige Zorg
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">
            Onze Behandelingen
          </h2>
          <p class="text-lg text-slate-600">
            Van periodieke preventieve controle tot complexe esthetische
            reconstructies. Complete tandheelkundige zorg onder één dak.
          </p>
        </div>
        <a
          href="/behandelingen"
          class="inline-flex items-center gap-2 bg-white text-primary-600 hover:text-primary-700 font-bold px-6 py-3 rounded-xl border border-slate-200 hover:border-primary-200 transition-colors shadow-sm self-start md:self-auto"
        >
          Bekijk alle behandelingen
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              title: "Algemene Tandheelkunde",
              desc: "Periodieke controle, vullingen en gebitsrenovatie met hoogwaardige tandkleurige composieten.",
              tag: "Basis & Preventie",
            },
            {
              title: "Mondhygiëne & Preventie",
              desc: "Grondige reiniging van tandsteen en tandplak voor gezond tandvlees en een frisse adem.",
              tag: "Gezond Tandvlees",
            },
            {
              title: "Esthetische Tandheelkunde",
              desc: "Facings, composiet bonding en professioneel veilig tanden bleken voor een perfecte glimlach.",
              tag: "Stralende Lach",
            },
            {
              title: "Kronen, Bruggen & Implantaten",
              desc: "Duurzame vervanging van ontbrekende of beschadigde tanden met een natuurlijke uitstraling.",
              tag: "Vaste Oplossingen",
            },
            {
              title: "Wortelkanaalbehandeling",
              desc: "Moderne, pijnloze behandeling met microscopische precisie om je eigen kies te behouden.",
              tag: "Pijnvrij & Behoud",
            },
            {
              title: "Kindertandheelkunde",
              desc: "Spelenderwijs wennen aan de tandarts. Volledig 100% vergoed vanuit de basisverzekering tot 18 jaar!",
              tag: "Gratis tot 18 jaar",
            },
          ].map((item) => (
            <a
              href="/behandelingen"
              class="group relative overflow-hidden rounded-2xl bg-white border border-slate-100 p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-full">
                    {item.tag}
                  </span>
                  <div class="w-9 h-9 bg-slate-50 group-hover:bg-primary-50 rounded-lg flex items-center justify-center text-slate-400 group-hover:text-primary-600 transition-colors">
                    <CheckCircle2 class="w-5 h-5" />
                  </div>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-primary-600 transition-colors">
                  {item.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  {item.desc}
                </p>
              </div>
              <span class="inline-flex items-center text-sm font-bold text-primary-600 group-hover:text-primary-700">
                Meer informatie
                <ArrowRight class="w-4 h-4 ml-1.5 group-hover:translate-x-1 transition-transform" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Angst voor de tandarts Spotlight -->
  <section
    class="py-20 md:py-24 bg-gradient-to-br from-primary-900 via-slate-900 to-slate-950 text-white relative overflow-hidden"
  >
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div
        class="absolute w-[600px] h-[600px] bg-primary-500 rounded-full blur-3xl -top-40 -right-40"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
      >
        <div>
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-primary-300 text-xs font-semibold uppercase tracking-wider mb-6"
          >
            <Smile class="w-4 h-4" />
            Specialisatie Angstbegeleiding
          </div>
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6 leading-tight"
          >
            Vind je een tandartsbezoek spannend? <span class="text-primary-300"
              >Je bent niet alleen.</span
            >
          </h2>
          <p class="text-slate-300 text-lg leading-relaxed mb-6">
            Meer dan 25% van de Nederlanders ziet op tegen een tandartsbezoek.
            Bij Tandartsenpraktijk Hengelo hebben we ruime ervaring met
            patiënten met milde tot ernstige tandartsangst.
          </p>
          <p class="text-slate-300 text-lg leading-relaxed mb-8">
            We nemen alle tijd, leggen iedere handeling van tevoren rustig uit
            en behandelen pas als jij er klaar voor bent. We oordelen nooit.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contact"
              class="inline-flex justify-center items-center gap-2 bg-primary-500 hover:bg-primary-400 text-slate-950 font-bold px-7 py-4 rounded-xl transition-colors text-base"
            >
              Vrijblijvend kennismaken
            </a>
            <a
              href="tel:0742480768"
              class="inline-flex justify-center items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold px-7 py-4 rounded-xl transition-colors border border-white/15 text-base"
            >
