---
import Layout from "../layouts/Layout.astro";
import { MapPin, Phone, Mail, Clock, Send } from "lucide-vue-next";
---

<Layout title="Contact">
  <!-- Hero Section -->
  <section
    class="pt-32 pb-16 md:pt-40 md:pb-24 bg-slate-50 border-b border-slate-100"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1
        class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4"
      >
        Neem <span class="text-primary-600">Contact</span> op
      </h1>
      <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
        Vragen, een afspraak inplannen of inschrijven als nieuwe patiënt? We
        helpen u graag verder.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-8">
            Praktijkgegevens
          </h2>

          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 shrink-0"
              >
                <MapPin class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">Adres</h3>
                <p class="text-slate-600">
                  Generatorstraat 12<br />7511 XL Hengelo
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 shrink-0"
              >
                <Phone class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">Telefoon</h3>
                <a
                  href="tel:0742480768"
                  class="text-slate-600 hover:text-primary-600 transition-colors"
                  >074 - 248 07 68</a
                >
                <p class="text-sm text-slate-500 mt-1">
                  Voor spoedgevallen, <a
                    href="/spoed"
                    class="text-primary-600 hover:underline"
                    >bekijk de spoedpagina</a
                  >.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 shrink-0"
              >
                <Mail class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">E-mail</h3>
                <a
                  href="mailto:info@tandartsenpraktijkhengelo.nl"
                  class="text-slate-600 hover:text-primary-600 transition-colors"
                  >info@tandartsenpraktijkhengelo.nl</a
                >
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 shrink-0"
              >
                <Clock class="w-6 h-6" />
              </div>
              <div class="w-full">
                <h3 class="font-bold text-slate-900 mb-2">Openingstijden</h3>
                <ul class="space-y-2 text-slate-600 text-sm w-full max-w-xs">
                  <li class="flex justify-between">
                    <span>Maandag</span>
                    <span>08:00 - 17:00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Dinsdag</span>
                    <span>08:00 - 20:00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Woensdag</span>
                    <span>08:00 - 17:00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Donderdag</span>
                    <span>08:00 - 17:00</span>
                  </li>
                  <li class="flex justify-between">
                    <span>Vrijdag</span>
                    <span>08:00 - 15:00</span>
                  </li>
                  <li class="flex justify-between text-slate-400">
                    <span>Zaterdag - Zondag</span>
                    <span>Gesloten</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div
          class="bg-white p-8 md:p-10 rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/40"
        >
          <h2 class="text-2xl font-bold text-slate-900 mb-6">
            Stuur een bericht
          </h2>
          <form
            class="space-y-5"
            onsubmit="event.preventDefault(); alert('Dit is een demo website.');"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label
                  for="firstName"
                  class="block text-sm font-medium text-slate-700 mb-1"
                  >Voornaam</label
                >
                <input
                  type="text"
                  id="firstName"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white"
                  placeholder="Jan"
                  required
                />
              </div>
              <div>
                <label
                  for="lastName"
                  class="block text-sm font-medium text-slate-700 mb-1"
                  >Achternaam</label
                >
                <input
                  type="text"
                  id="lastName"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white"
                  placeholder="Smit"
                  required
                />
              </div>
            </div>

            <div>
              <label
                for="email"
                class="block text-sm font-medium text-slate-700 mb-1"
                >E-mailadres</label
              >
              <input
                type="email"
                id="email"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white"
                placeholder="jan@voorbeeld.nl"
                required
              />
            </div>

            <div>
              <label
                for="phone"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Telefoonnummer</label
              >
              <input
                type="tel"
                id="phone"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white"
                placeholder="06 12345678"
              />
            </div>

            <div>
              <label
                for="subject"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Onderwerp</label
              >
              <select
                id="subject"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white"
              >
                <option>Nieuwe inschrijving</option>
                <option>Afspraak maken / wijzigen</option>
                <option>Vraag over behandeling</option>
                <option>Anders</option>
              </select>
            </div>

            <div>
              <label
                for="message"
                class="block text-sm font-medium text-slate-700 mb-1"
                >Bericht</label
              >
              <textarea
                id="message"
                rows="4"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all bg-slate-50 focus:bg-white resize-none"
                placeholder="Typ hier uw bericht..."></textarea>
            </div>

            <button
              type="submit"
              class="w-full inline-flex justify-center items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-6 py-4 rounded-xl font-bold transition-colors shadow-md"
            >
              <Send class="w-5 h-5" /> Bericht Versturen
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
